{
    "version": "2.0.0",
    "tasks": [
        {
            // 기본 빌드(Ctrl/Cmd+Shift+B). OS 에 따라 알맞은 빌드 폴더를 빌드한다.
            //   Windows → build_win32 (Visual Studio 제너레이터)
            //   macOS   → build_mac   (Xcode 제너레이터, kw4_x 데스크톱 타깃)
            "label": "cmake build Debug",
            "type": "shell",
            "command": "cmake",
            "windows": {
                "args": [
                    "--build", "${workspaceFolder}/kw4_x/build_win32",
                    "--config", "Debug"
                ]
            },
            "osx": {
                "args": [
                    "--build", "${workspaceFolder}/kw4_x/build_mac",
                    "--config", "Debug",
                    "--target", "kw4_x",
                    "-j4"
                ]
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$msCompile", "$gcc"],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            // macOS 전용: Xcode 프로젝트를 직접 빌드
            "label": "xcode build Debug (mac only)",
            "type": "shell",
            "command": "xcodebuild",
            "args": [
                "-project", "${workspaceFolder}/kw4_x/build_mac/kw4_x.xcodeproj",
                "-scheme", "kw4_x",
                "-configuration", "Debug",
                "build"
            ],
            "group": "build",
            "problemMatcher": ["$gcc"],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        }
    ]
}
